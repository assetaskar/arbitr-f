# Только ${BACKEND_URL} подставляется envsubst'ом (он есть в окружении).
# Переменные nginx ($uri, $host, $http_upgrade, ...) не трогаются.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA: любые пути отдаём в index.html (клиентский роутинг).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # REST API → бэкенд (URI /api/... передаётся как есть).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # WebSocket → бэкенд (нужен upgrade и длинный таймаут).
    location /ws {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }
}
